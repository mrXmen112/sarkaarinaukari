# --- Supabase ---------------------------------------------------------------
# Project Settings > API. Get these after creating the Supabase project and
# running supabase/migrations/0001_initial_schema.sql.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Server-side only. NEVER expose this to the browser or commit it to git.
# Used by the Phase 10 admin panel and cron duties.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Optional: the account email that is auto-granted admin on sign-in/sign-up
# (upserted into admin_users via the service-role key). Leave unset to disable.
ADMIN_EMAIL=your-admin@example.com

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.sarkaarinaukri.online

# --- Pipeline LLM (Phase C structuring, scripts/scraper only) ----------------
# Server-side only. NEVER expose to the browser or commit a real key to git.
# Any OpenAI-compatible endpoint works (OpenAI, OpenRouter, ...).
# Live structuring stays disabled until LLM_API_KEY is set; --dry-run works
# without it.
# LLM_API_KEY=YOUR_LLM_KEY
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_MAX_TOKENS=2000

# --- Automation (Phase 1) ----------------------------------------------------
# Shared secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>".
# Reuse the same value in Supabase (alter database postgres set
# app.cron_secret = '<same>') if you enable the pg_cron snippet from
# migration 0016. Generate one with: openssl rand -hex 24
CRON_SECRET=

# Optional: post newly approved jobs to a Telegram channel. The bot must be an
# admin of the channel; get the chat id (starts with -100) from @userinfobot.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Search engine verification (Phase 2) ------------------------------------
# Paste the content values from Search Console / Bing Webmaster Tools meta tags.
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=

# --- AdSense (Phase 5, optional) -------------------------------------------
# Leave these unset until your AdSense account is approved. Ad slots stay
# invisible-but-space-reserved until the client id is present, so enabling
# ads later never shifts content.
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
# NEXT_PUBLIC_ADSENSE_SLOT_JOB=XXXXXXXXXX
# NEXT_PUBLIC_ADSENSE_SLOT_LIST=XXXXXXXXXX

# Comma-separated social/profile URLs for schema.org sameAs (optional).
# SITE_SAME_AS=https://www.facebook.com/yourpage,https://twitter.com/yourhandle

# IndexNow key (public/<key>.txt is served; set the same key in Vercel env)INDEXNOW_KEY=
